<Project>
    <PropertyGroup>
        <CefGlueBrowserProcessDir>CefGlueBrowserProcess</CefGlueBrowserProcessDir>
    </PropertyGroup>

    <!--
      NuGet imports build props before the consumer project sets RuntimeIdentifier.
      Resolve the target RID here, at build time, so a macOS host cross-building a
      Windows/Linux consumer never selects a Mach-O browser process by accident.
    -->
    <Target Name="ResolveCefGlueRuntimeItems" BeforeTargets="AssignTargetPaths">
        <PropertyGroup>
            <CefGlueTargetPlatform Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</CefGlueTargetPlatform>
            <CefGlueTargetPlatform Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows')) and '$(Platform)' == 'x64'">win-x64</CefGlueTargetPlatform>
            <CefGlueTargetPlatform Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows')) and '$(Platform)' == 'ARM64'">win-arm64</CefGlueTargetPlatform>
            <CefGlueTargetPlatform Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux')) and '$(Platform)' == 'x64'">linux-x64</CefGlueTargetPlatform>
            <CefGlueTargetPlatform Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux')) and '$(Platform)' == 'ARM64'">linux-arm64</CefGlueTargetPlatform>
            <CefGlueTargetPlatform Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX')) and '$(Platform)' == 'x64'">osx-x64</CefGlueTargetPlatform>
            <CefGlueTargetPlatform Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX')) and '$(Platform)' == 'ARM64'">osx-arm64</CefGlueTargetPlatform>
            <CefGlueTargetPlatform Condition="'$(CefGlueTargetPlatform)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</CefGlueTargetPlatform>
            <CefGlueTargetPlatform Condition="'$(CefGlueTargetPlatform)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</CefGlueTargetPlatform>
            <CefGlueTargetPlatform Condition="'$(CefGlueTargetPlatform)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">osx-x64</CefGlueTargetPlatform>
        </PropertyGroup>
        <ItemGroup>
            <CefGlueBrowserProcessFiles Remove="@(CefGlueBrowserProcessFiles)" />
            <CefGlueBrowserProcessFiles Include="$(MSBuildThisFileDirectory)..\bin\$(CefGlueTargetPlatform)\*"
                                        Condition="'$(CefGlueTargetPlatform)' != ''" />
            <None Include="@(CefGlueBrowserProcessFiles)">
                <Visible>false</Visible>
                <Link>$(OutputDirectory)$(CefGlueBrowserProcessDir)\%(RecursiveDir)%(FileName)%(Extension)</Link>
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
                <PublishState>Included</PublishState>
            </None>
            <None Condition="'$(CefGlueTargetPlatform)' == 'osx-x64'" Include="@(CefRedistOSX64)">
                <Visible>false</Visible>
                <Link>$(OutputDirectory)%(RecursiveDir)%(FileName)%(Extension)</Link>
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
                <PublishState>Included</PublishState>
            </None>
            <None Condition="'$(CefGlueTargetPlatform)' == 'osx-arm64'" Include="@(CefRedistOSXARM64)">
                <Visible>false</Visible>
                <Link>$(OutputDirectory)%(RecursiveDir)%(FileName)%(Extension)</Link>
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
                <PublishState>Included</PublishState>
            </None>
            <None Condition="'$(CefGlueTargetPlatform)' == 'linux-x64'" Include="@(CefRedistLinux64)">
                <Visible>false</Visible>
                <Link>$(OutputDirectory)%(RecursiveDir)%(FileName)%(Extension)</Link>
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
                <PublishState>Included</PublishState>
            </None>
            <None Condition="'$(CefGlueTargetPlatform)' == 'linux-arm64'" Include="@(CefRedistLinuxARM64)">
                <Visible>false</Visible>
                <Link>$(OutputDirectory)%(RecursiveDir)%(FileName)%(Extension)</Link>
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
                <PublishState>Included</PublishState>
            </None>
        </ItemGroup>
    </Target>

    <!-- Copy CEF resources and locales to the locations expected by CEF. -->
    <Target Name="ResolveCEFAssets" Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(CefGlueTargetPlatform)' != ''" AfterTargets="ResolveLockFileCopyLocalFiles" BeforeTargets="AssignTargetPaths">
        <ItemGroup Condition="'$(CefGlueTargetPlatform)' == 'win-x64' OR '$(CefGlueTargetPlatform)' == 'win-arm64'">
            <CefRuntimeFiles Include="@(RuntimeTargetsCopyLocalItems->WithMetadataValue('NuGetPackageId', 'chromiumembeddedframework.runtime.$(CefGlueTargetPlatform)'))" />
            <CefRuntimeFiles Remove="@(CefRuntimeFiles)"
                             Condition="$([System.String]::Copy('%(FullPath)').Contains('\Resources\locales\'))" />
            <None Include="@(CefRuntimeFiles)">
                <Visible>false</Visible>
                <Link>$(OutputDirectory)%(FileName)%(Extension)</Link>
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
                <PublishState>Included</PublishState>
            </None>
        </ItemGroup>
        <ItemGroup>
            <CefRuntimeLocales Include="@(ReferenceCopyLocalPaths->WithMetadataValue('NuGetPackageId', 'chromiumembeddedframework.runtime.win-x64'))"
                               Condition="'$(CefGlueTargetPlatform)' == 'win-x64' and $([System.String]::Copy('%(FullPath)').Contains('\Resources\locales\'))" />
            <CefRuntimeLocales Include="@(ReferenceCopyLocalPaths->WithMetadataValue('NuGetPackageId', 'chromiumembeddedframework.runtime.win-arm64'))"
                               Condition="'$(CefGlueTargetPlatform)' == 'win-arm64' and $([System.String]::Copy('%(FullPath)').Contains('\Resources\locales\'))" />
            <ReferenceCopyLocalPaths Remove="@(CefRuntimeLocales)" />
            <None Include="@(CefRuntimeLocales)">
                <Visible>false</Visible>
                <Link>$(OutputDirectory)locales\%(FileName)%(Extension)</Link>
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
                <PublishState>Included</PublishState>
            </None>
        </ItemGroup>
    </Target>

    <Target Name="RemoveCEFLocaleRootPublishAssets"
            Condition="$([MSBuild]::IsOSPlatform('Windows')) and ('$(CefGlueTargetPlatform)' == 'win-x64' or '$(CefGlueTargetPlatform)' == 'win-arm64')"
            AfterTargets="_ComputeResolvedCopyLocalPublishAssets"
            BeforeTargets="ComputeFilesToPublish">
        <ItemGroup>
            <_CefLocaleRootPublishAssets Include="@(_ResolvedCopyLocalPublishAssets)"
                Condition="('%(_ResolvedCopyLocalPublishAssets.NuGetPackageId)' == 'chromiumembeddedframework.runtime.win-x64' or '%(_ResolvedCopyLocalPublishAssets.NuGetPackageId)' == 'chromiumembeddedframework.runtime.win-arm64') and $([System.String]::Copy('%(_ResolvedCopyLocalPublishAssets.FullPath)').Contains('\Resources\locales\'))" />
            <_ResolvedCopyLocalPublishAssets Remove="@(_CefLocaleRootPublishAssets)" />
        </ItemGroup>
    </Target>

    <!-- NuGet archives do not reliably preserve Unix executable bits. -->
    <Target Name="Ensure9n1mWebViewExecutableInOutput"
            AfterTargets="CopyFilesToOutputDirectory"
            Condition="!$([MSBuild]::IsOSPlatform('Windows')) And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'osx-x64' Or '$(RuntimeIdentifier)' == 'osx-arm64' Or '$(RuntimeIdentifier)' == 'linux-x64' Or '$(RuntimeIdentifier)' == 'linux-arm64') And Exists('$(OutDir)$(CefGlueBrowserProcessDir)/9n1m.webview')">
        <Exec Command="chmod +x &quot;$(OutDir)$(CefGlueBrowserProcessDir)/9n1m.webview&quot;" />
    </Target>

    <Target Name="Ensure9n1mWebViewExecutableInPublish"
            AfterTargets="Publish"
            Condition="!$([MSBuild]::IsOSPlatform('Windows')) And ('$(PublishDir)' != '') And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'osx-x64' Or '$(RuntimeIdentifier)' == 'osx-arm64' Or '$(RuntimeIdentifier)' == 'linux-x64' Or '$(RuntimeIdentifier)' == 'linux-arm64') And Exists('$(PublishDir)$(CefGlueBrowserProcessDir)/9n1m.webview')">
        <Exec Command="chmod +x &quot;$(PublishDir)$(CefGlueBrowserProcessDir)/9n1m.webview&quot;" />
    </Target>
</Project>
