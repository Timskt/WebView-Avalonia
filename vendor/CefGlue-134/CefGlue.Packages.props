<?xml version="1.0" encoding="utf-8"?>
<Project>
    <!-- Empty means all supported native RIDs; CI can narrow this to the
         native packages that were actually built (for example win-x64). -->
    <PropertyGroup>
        <CodecRuntimeRids Condition="'$(CodecRuntimeRids)' == ''">win-x64;win-arm64;osx-x64;osx-arm64;linux-x64;linux-arm64</CodecRuntimeRids>
    </PropertyGroup>

    <ItemGroup Condition="'$(Platform)' == 'x64' and $([System.String]::Copy('$(CodecRuntimeRids)').Contains('win-x64'))">
        <PackageReference PrivateAssets="None" Include="chromiumembeddedframework.runtime.win-x64" />
    </ItemGroup>
    <ItemGroup Condition="'$(Platform)' == 'x64' and $([System.String]::Copy('$(CodecRuntimeRids)').Contains('osx-x64'))">
        <PackageReference PrivateAssets="None" Include="cef.redist.osx64" />
    </ItemGroup>
    <ItemGroup Condition="'$(Platform)' == 'x64' and $([System.String]::Copy('$(CodecRuntimeRids)').Contains('linux-x64'))">
        <PackageReference PrivateAssets="None" Include="cef.redist.linux64" />
    </ItemGroup>

    <ItemGroup Condition="'$(Platform)' == 'ARM64' and $([System.String]::Copy('$(CodecRuntimeRids)').Contains('win-arm64'))">
        <PackageReference PrivateAssets="None" Include="chromiumembeddedframework.runtime.win-arm64" />
    </ItemGroup>
    <ItemGroup Condition="'$(Platform)' == 'ARM64' and $([System.String]::Copy('$(CodecRuntimeRids)').Contains('osx-arm64'))">
        <PackageReference PrivateAssets="None" Include="cef.redist.osx.arm64" />
    </ItemGroup>
    <ItemGroup Condition="'$(Platform)' == 'ARM64' and $([System.String]::Copy('$(CodecRuntimeRids)').Contains('linux-arm64'))">
        <PackageReference PrivateAssets="None" Include="cef.redist.linuxarm64" />
    </ItemGroup>

    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) and ($([System.String]::Copy('$(CodecRuntimeRids)').Contains('win-x64')) or $([System.String]::Copy('$(CodecRuntimeRids)').Contains('win-arm64')))">
        <PackageReference PrivateAssets="None" Include="chromiumembeddedframework.runtime" />
    </ItemGroup>
</Project>
